{
  "name": "@rkds/server",
  "version": "0.0.0",
  "private": true,
  "description": "RKDS API and realtime server",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "dev": "node --watch --import tsx src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:check": "node scripts/migrate-check.mjs",
    "owner:create": "tsx src/cli/create-owner.ts",
    "owner:list": "tsx src/cli/list-owners.ts",
    "owner:reset-password": "tsx src/cli/reset-owner-password.ts",
    "owner:disable": "tsx src/cli/disable-owner.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@rkds/shared": "*",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
